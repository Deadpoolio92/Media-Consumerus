# Example environment for the Media Tracker fork.
#
# For local Docker runs the maintainer sets these inline in the git-ignored
# docker-compose.override.yml (see CLAUDE.md "Local run"); this file is the
# checked-in reference for what each key does. Never commit real secrets.

# --- Host port --------------------------------------------------------------
# YAMTRACK_PORT: host-side port for the web UI. docker-compose.yml binds
#   127.0.0.1:${YAMTRACK_PORT:-7040}:8000 — 7040 is Media Consumerus's block
#   base (reserved-port-blocks preference). Override in a local .env if 7040
#   is ever taken on this machine.
YAMTRACK_PORT=

# --- Crunchyroll sync (E9) -------------------------------------------------
# E9a = the one-off `manage.py backfill_crunchyroll_availability` command (C1
# dub/sub). E9b = the daily "Sync Crunchyroll" beat + `manage.py
# sync_crunchyroll_status` (watchlist->status, history->progress). These are
# admin-level secrets, kept here like SECRET/TMDB_API.
#
# CRUNCHYROLL_ETP_RT: the long-lived `etp_rt` cookie. Capture once from a
#   logged-in browser: DevTools -> Application -> Cookies -> crunchyroll.com ->
#   copy the `etp_rt` value.
CRUNCHYROLL_ETP_RT=

# CRUNCHYROLL_BASIC_AUTH: the public CR web-client `Authorization: Basic ...`
#   header value (unofficial; the same for all web users). Capture from DevTools
#   -> Network -> the POST to /auth/v1/token -> Request Headers -> Authorization.
#   May include or omit the leading "Basic ".
CRUNCHYROLL_BASIC_AUTH=

# CRUNCHYROLL_PROFILE_ID: the maintainer's own profile on the shared CR account.
#   Only used by E9b (watchlist/history sync); discover it with
#   `manage.py list_crunchyroll_profiles`. Leave blank for E9a. The E9b sync
#   refuses to write unless the minted token confirms this exact profile.
CRUNCHYROLL_PROFILE_ID=

# CRUNCHYROLL_USERNAME: which fork user the E9b watchlist/history sync writes to.
#   Leave blank if you have exactly one user (the personal-fork norm) — it's
#   picked automatically; set it only on a multi-user install.
CRUNCHYROLL_USERNAME=
